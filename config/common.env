ROS_DOMAIN_ID=42
FCU_URL=serial:///dev/serial0:115200
FCU_BAUD=115200
GCS_URL=
COLOR_PROFILE=640x480x15
DEPTH_PROFILE=640x360x15
# Logicool C270 (046d:0825)を標準使用。D455へ戻す場合はrealsenseへ変更する。
CAMERA_DRIVER=usb
USB_CAMERA_DEVICE=/dev/video0
USB_CAMERA_WIDTH=640
USB_CAMERA_HEIGHT=480
USB_CAMERA_FPS=15
USB_CAMERA_PIXEL_FORMAT=YUYV
USB_CAMERA_OUTPUT_ENCODING=rgb8
USB_CAMERA_INFO_URL=file:///config/usb_camera.yaml
USB_CAMERA_FRAME=usb_camera_color_optical_frame
# FC/base_link中心からレンズ中心まで、機首前方へ7.5 cm、下へ15 cm。
USB_CAMERA_OFFSET_X=0.075
USB_CAMERA_OFFSET_Y=0.0
USB_CAMERA_OFFSET_Z=-0.15
DETECTION_ONLY=false
ENABLE_DEPTH=false
ENABLE_IMU=false
ENABLE_POINTCLOUD=false
ALIGN_DEPTH=false
SEARCH_HEIGHT=2.0
LANDING_MARKER_ID=102
# 印刷後に黒枠の外辺を実測した値（m）へ必ず合わせる。
MARKER_LENGTH=0.15
CENTERING_TOLERANCE=0.15
CENTER_CONFIRM_FRAMES=5
MARKER_LOST_TIMEOUT=1.0
CENTERING_COMMAND_RATE=5.0
CENTERING_MAX_STEP=0.04
CENTERING_MIN_STEP=0.005
CENTERING_SLOW_RADIUS=0.75
SEARCH_ANGLE_STEP_DEG=0.36
MAX_SEARCH_RADIUS=3.0
# 半径3 mの探索域に、測位誤差・制動用の0.5 mを加えた安全境界。
GEOFENCE_RADIUS=3.5
PROBE_GRID_SIZE=1.0
# 離陸時に機首を審判座標の+Yへ向け、機体右を+Xとして出力する。
PROBE_NOSE_POINTS_POSITIVE_Y=true
ENABLE_PROBE_PRACTICE=true
# イエローグリーンprobe。草の誤検出を抑える色・形状・連続確認条件。
PROBE_HUE_MIN=25
PROBE_HUE_MAX=45
PROBE_SATURATION_MIN=100
PROBE_VALUE_MIN=100
PROBE_MIN_AREA=150
PROBE_MAX_AREA=60000
PROBE_MIN_SOLIDITY=0.80
PROBE_MIN_ASPECT=3.5
PROBE_MAX_ASPECT=10.0
PROBE_MIN_RECT_FILL=0.60
PROBE_LENGTH=0.20
PROBE_MIN_DIAMETER=0.02
PROBE_MAX_DIAMETER=0.03
PROBE_SIZE_TOLERANCE=0.55
PROBE_CONFIRM_FRAMES=5
PROBE_CONFIRM_RADIUS=0.25
# 地上試験時のbase_link（FC中心）の床からの高さ。
PRACTICE_BASE_HEIGHT=2.0
DEVICE_WAIT_TIMEOUT=120
# 0ならFCが後から起動する構成でも、接続・Disarm確認を無期限に待つ。
READY_TIMEOUT=0
READY_STABLE_COUNT=3
START_TRIGGER=rc
RC_START_CHANNEL=7
RC_LOW_THRESHOLD=1200
RC_HIGH_THRESHOLD=1800
RC_HIGH_HOLD_SECONDS=1.0
REQUIRE_RC_LOW_FIRST=true
STATUS_LED_TYPE=ws281x
STATUS_LED_GPIO=18
STATUS_LED_COUNT=8
# 0～255。電源と発熱に余裕を持たせるため25%から開始する。
STATUS_LED_BRIGHTNESS=64
AUTO_START_DELAY=5
