# Safe example. Use select-mode.sh instead of editing this directly.
ROS_DOMAIN_ID=42
FCU_URL=serial:///dev/serial0:115200
FCU_BAUD=115200
GCS_URL=
COLOR_PROFILE=640x480x15
DEPTH_PROFILE=640x360x15
USB_CAMERA_OFFSET_X=0.075
USB_CAMERA_OFFSET_Y=0.0
USB_CAMERA_OFFSET_Z=-0.15
ENABLE_DEPTH=true
ENABLE_IMU=false
ENABLE_POINTCLOUD=false
ALIGN_DEPTH=false
SEARCH_HEIGHT=2.0
LANDING_MARKER_ID=102
MARKER_LENGTH=0.15
CENTERING_TOLERANCE=0.15
CENTER_CONFIRM_FRAMES=5
MARKER_LOST_TIMEOUT=1.0
CENTERING_COMMAND_RATE=5.0
CENTERING_MAX_STEP=0.04
CENTERING_MIN_STEP=0.005
CENTERING_SLOW_RADIUS=0.75
SEARCH_ANGLE_STEP_DEG=0.36
MAX_SEARCH_RADIUS=3.0
GEOFENCE_RADIUS=3.5
PROBE_HUE_MIN=25
PROBE_NOSE_POINTS_POSITIVE_Y=true
PROBE_HUE_MAX=45
PROBE_SATURATION_MIN=100
PROBE_VALUE_MIN=100
PROBE_MIN_AREA=150
PROBE_MAX_AREA=60000
PROBE_MIN_SOLIDITY=0.80
PROBE_MIN_ASPECT=3.5
PROBE_MAX_ASPECT=10.0
PROBE_MIN_RECT_FILL=0.60
PROBE_LENGTH=0.20
PROBE_MIN_DIAMETER=0.02
PROBE_MAX_DIAMETER=0.03
PROBE_SIZE_TOLERANCE=0.55
PROBE_CONFIRM_FRAMES=5
PROBE_CONFIRM_RADIUS=0.25
DEVICE_WAIT_TIMEOUT=120
# 0ならFCが後から起動しても無期限に待機する。
READY_TIMEOUT=0
READY_STABLE_COUNT=3
START_TRIGGER=rc
RC_START_CHANNEL=7
RC_LOW_THRESHOLD=1200
RC_HIGH_THRESHOLD=1800
RC_HIGH_HOLD_SECONDS=1.0
REQUIRE_RC_LOW_FIRST=true
RGB_LED_RED_GPIO=17
RGB_LED_GREEN_GPIO=27
RGB_LED_BLUE_GPIO=22
AUTO_START_DELAY=5
OPERATION_MODE=practice
AUTONOMOUS_FLIGHT_ACK=DISABLED
